# Backend (copy to backend/.env)
PORT=4000
NODE_ENV=DEV
FRONTEND_URL=http://localhost:3000
# Local: FE nhận publicToken. Trên Render đừng set localhost — backend dùng /cas/callback công khai.
CAS_REDIRECT_URI=http://localhost:3000/cas/callback
# Production example (set on host, whitelist in Cas Console):
# CAS_REDIRECT_URI=https://paymentvietqr.onrender.com/cas/callback
# PUBLIC_API_URL=https://paymentvietqr.onrender.com
# FRONTEND_URL=https://your-frontend.example.com

# Cas sandbox (https://cas.so/en/product/qr-pay/)
CAS_BASE_URL=https://sandbox.bankhub.dev
CAS_LINK_URL=https://dev.link.bankhub.dev
CAS_API_VERSION=2023-01-01
CAS_ENVIRONMENT=dev
CAS_CLIENT_ID=
CAS_SECRET_KEY=

# MongoDB Atlas
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/paymentvietqr?retryWrites=true&w=majority

# Optional: timeout for Cas HTTP calls (ms)
CAS_TIMEOUT_MS=15000

# Frontend (copy to frontend/.env.local)
NEXT_PUBLIC_API_URL=http://localhost:4000
